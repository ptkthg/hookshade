# SOMENTE desenvolvimento local. Todos os valores são placeholders públicos.
POSTGRES_USER=hookshade
POSTGRES_PASSWORD=dev-only-postgres-placeholder
POSTGRES_DB=hookshade
HOOKSHADE_ENV=development
HOOKSHADE_SECRET_KEY=dev-only-secret-placeholder-not-for-production
HOOKSHADE_ENCRYPTION_KEY=dev-only-encryption-placeholder-not-for-production
HOOKSHADE_SEED_EMAIL=admin@example.com
HOOKSHADE_SEED_PASSWORD=dev-only-admin-placeholder
HOOKSHADE_DATABASE_URL=postgresql://hookshade:dev-only-postgres-placeholder@postgres:5432/hookshade
HOOKSHADE_CORS_ORIGINS=http://localhost:3000
HOOKSHADE_COOKIE_SECURE=false
HOOKSHADE_COOKIE_SAMESITE=lax
HOOKSHADE_CSRF_HEADER_NAME=X-CSRF-Token
HOOKSHADE_HSTS_ENABLED=false
HOOKSHADE_HSTS_MAX_AGE=31536000
HOOKSHADE_RETENTION_DAYS=90
HOOKSHADE_ACCESS_TOKEN_EXPIRE_MINUTES=30
HOOKSHADE_LOGIN_MAX_ATTEMPTS=10
HOOKSHADE_LOGIN_LOCKOUT_MINUTES=15
HOOKSHADE_RATE_LIMIT_LOGIN_PER_MINUTE=10
HOOKSHADE_RATE_LIMIT_ANALYSES_PER_MINUTE=30
DEMO_ENABLED=true
DEMO_PASSWORD=dev-only-demo-placeholder
# Validade própria do JWT e cookie demo, em minutos (inteiro positivo).
DEMO_SESSION_MINUTES=30
# Preview efêmero: bytes UTF-8; limites por IP e teto global por processo.
PREVIEW_MAX_BYTES=65536
PREVIEW_RATE_PER_MINUTE=5
PREVIEW_RATE_PER_HOUR=30
PREVIEW_GLOBAL_PER_HOUR=300
BACKEND_INTERNAL_URL=http://api:8000
CSP_REPORT_ONLY=false
