# Ambiente: "development" (default) ou "production".
# Em production, a app RECUSA subir com segredos fracos/default (fail-closed).
HOOKSHADE_ENV=development

# OBRIGATÓRIOS e FORTES em produção (>= 32 chars, aleatórios). Gere com, ex.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
HOOKSHADE_SECRET_KEY=change-me-in-production-use-a-32byte-plus-secret
HOOKSHADE_ENCRYPTION_KEY=

# Credenciais do usuário admin semeado — TROQUE em produção.
HOOKSHADE_SEED_EMAIL=analyst@hookshade.local
HOOKSHADE_SEED_PASSWORD=changeme123

# Restrinja às origens do frontend (CSV). Sem curinga "*" em produção.
HOOKSHADE_CORS_ORIGINS=http://localhost:3000

# Use Postgres em produção (SQLite não sobrevive a redeploys efêmeros).
HOOKSHADE_DATABASE_URL=sqlite:///./hookshade.db

HOOKSHADE_RETENTION_DAYS=90
HOOKSHADE_ACCESS_TOKEN_EXPIRE_MINUTES=30
